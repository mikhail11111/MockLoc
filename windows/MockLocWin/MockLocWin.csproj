<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Versioned Windows TFM makes the .NET SDK restore the Windows projection
         (Microsoft.Windows.SDK.NET.Ref) automatically as a targeting pack. -->
    <TargetFramework>net9.0-windows10.0.22621.0</TargetFramework>
    <Nullable>disable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>MockLocWin</AssemblyName>
    <RootNamespace>MockLocWin</RootNamespace>
  </PropertyGroup>
</Project>
